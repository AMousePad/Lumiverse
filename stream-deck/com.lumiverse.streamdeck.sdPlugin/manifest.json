{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Name": "Open Recent Chat",
      "UUID": "com.lumiverse.streamdeck.openrecent",
      "Icon": "imgs/action",
      "PropertyInspectorPath": "ui/property-inspector.html",
      "States": [
        {
          "Image": "imgs/action",
          "TitleAlignment": "middle",
          "FontSize": 12
        }
      ]
    },
    {
      "Name": "Open Character Chat",
      "UUID": "com.lumiverse.streamdeck.opencharacter",
      "Icon": "imgs/action",
      "PropertyInspectorPath": "ui/property-inspector.html",
      "States": [
        {
          "Image": "imgs/action",
          "TitleAlignment": "bottom",
          "FontSize": 11
        }
      ]
    }
  ],
  "Author": "Lumiverse",
  "Category": "Lumiverse",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/plugin.cjs",
  "Description": "Open recent Lumiverse character chats from Stream Deck.",
  "Name": "Lumiverse",
  "Icon": "imgs/plugin",
  "Nodejs": {
    "Version": "20"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "PropertyInspectorPath": "ui/property-inspector.html",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.6"
  },
  "UUID": "com.lumiverse.streamdeck",
  "Version": "0.1.0.5"
}